{
  "go.useLanguageServer": true,
  "go.lintTool": "golangci-lint",
  "go.lintFlags": ["--fast"],
  "go.formatTool": "gofumpt",
  "go.buildTags": "",
  "go.testFlags": ["-v", "-count=1"],
  "files.exclude": {
    "bin/": true,
    "dist/": true
  },
  "editor.formatOnSave": true,
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}
