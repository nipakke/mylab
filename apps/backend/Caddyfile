{
    # Admin API on port :2018 to avoid conflict with system FrankenPHP
    admin :2018
}

http://localhost:8000 {
    # Serve static assets (CSS, JS, images, favicons) directly from FrankenPHP
    root * ./public

    # Static file serving for /assets/*
    handle /assets/* {
        file_server
    }

    # All dynamic requests proxied to ReactPHP worker kernel
    handle {
        reverse_proxy 127.0.0.1:8080
    }

    log {
        output stderr
    }
}
