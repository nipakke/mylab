{
  "name": "shipped/backend",
  "description": "Asynchronous PHP Hypermedia Monolith Core",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "react/http": "^1.9",
    "react/stream": "^1.4",
    "twig/twig": "^3.0",
    "nikic/fast-route": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Shipped\\Backend\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require-dev": {
    "pestphp/pest": "^3.0"
  }
}
