{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "APP_ENV=local php src/server.php",
        "cwd": "apps/backend"
      }
    },
    "dev:full": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "frankenphp run --config Caddyfile",
          "APP_ENV=local php src/server.php"
        ],
        "parallel": true,
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./vendor/bin/pest",
        "cwd": "apps/backend"
      }
    }
  }
}
