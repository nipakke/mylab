{
  "name": "shipped/backend",
  "description": "Asynchronous PHP Hypermedia Monolith Core",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "clue/docker-react": "^1.6",
    "react/http": "^1.9",
    "react/stream": "^1.4",
    "twig/twig": "^3.0",
    "nikic/fast-route": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Shipped\\Backend\\": "src/"
    },
    "files": [
      "src/Domain/label-parser.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "format": "pint",
        "lint": [
            "pint --test",
            "parallel-lint src/",
            "phpstan analyse --configuration=phpstan.neon"
        ]
    }
}
