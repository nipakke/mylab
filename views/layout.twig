<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dracula">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>

    {% if is_dev %}
        <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
        <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    {% else %}
        <script src="/assets/js/htmx.js"></script>
        <link rel="stylesheet" href="/assets/css/app.min.css">
    {% endif %}


</head>
<body class="h-full antialiased font-sans bg-base-100 text-base-content">
    <main class="p-8 max-w-6xl mx-auto">
        {% block content %}{% endblock %}
    </main>

    {% if is_dev %}
    <script>
    (function () {
        var es = new EventSource('/dev/reload');
        es.onerror = function () {
            es.close();
            console.log('[dev] server restarting, waiting...');
            var attempts = 0;
            var poll = setInterval(function () {
                var xhr = new XMLHttpRequest();
                xhr.open('HEAD', '/', true);
                xhr.onload = function () {
                    clearInterval(poll);
                    location.reload();
                };
                xhr.send();
                if (++attempts > 300) clearInterval(poll);
            }, 1000);
        };
    })();
    </script>
    {% endif %}
</body>
</html>
