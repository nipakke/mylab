{% for container in containers %}
{% set c = container.toArray() %}
<tr class="border-base-800 hover:bg-base-800/40 transition-colors">
    <td class="font-mono text-xs text-slate-400">{{ c.id }}</td>
    <td class="font-bold">{{ c.name }}</td>
    <td>
        <span class="badge {{ c.badgeClass }} badge-sm font-semibold text-xs">{{ c.status }}</span>
    </td>
</tr>
{% else %}
<tr>
    <td colspan="3" class="text-center text-slate-500 py-4">No active nodes detected.</td>
</tr>
{% endfor %}
